# Aura Rudraksha Backend Configuration
# Provide your MongoDB connection string below (e.g. MongoDB Atlas cluster or local MongoDB instance)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/aura_rudraksha
PORT=3000
NODE_ENV=development
# Only set to "true" in local development. Even then, NODE_ENV must also not
# be "production" for the fallback to activate. Never set this in production.
ALLOW_DEV_AUTH_FALLBACK=false
# Rate limiting is ON by default everywhere, including local dev. Only set
# this to "true" if you need to disable it for local testing convenience —
# it is ignored (rate limiting stays on) whenever NODE_ENV=production.
DISABLE_RATE_LIMIT=false
INITIAL_ADMIN_EMAIL=rohitjangir8740@gmail.com
INITIAL_ADMIN_PHONE=+919672996531
# NVIDIA NIM API Key for Aura AI (Keep server-side only)
NVIDIA_API_KEY=

# Upstash Redis & Ratelimit Configuration (for distributed serverless rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay Payment Gateway Configuration (Keep secret key server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Firebase Admin (server-side token verification)
# Option A (recommended for serverless/Vercel/Cloudflare): point at a service
#   account JSON file exported from Firebase Console > Project settings.
FIREBASE_SERVICE_ACCOUNT_KEYFILE=
# Option B: inline values (alternative to the key file)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_PROJECT_ID=
# If neither is provided, firebase-admin falls back to Application Default
# Credentials (works on GCP; token verification will fail elsewhere).
# NOTE: the web app still authenticates customers through the public Firebase
# SDK (firebase-applet-config.json). The service account is ONLY for the server
# to verify those ID tokens and enforce admin roles.

# CORS: comma-separated list of extra allowed origins (empty = same-origin only)
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Frontend / Vite variables (exposed to browser)
# Only set these for SPLIT deployments (Cloudflare Pages frontend + separate
# Node/Express API backend). For the single-server deploy (Node serves dist/),
# leave VITE_API_BASE_URL commented out so the browser uses same-origin /api.
# VITE_API_BASE_URL=https://api.aurarudraksha.com/api
