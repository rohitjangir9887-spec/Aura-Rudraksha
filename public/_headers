# Cloudflare Pages & Edge Caching Headers
# HTML Entrypoint (Always revalidate, allow search engine indexing)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# SEO Sitemaps & Product Catalog Feeds
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/google-merchant-feed.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/merchant-feed.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/facebook-catalog-feed.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/meta-catalog-feed.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Hashed Vite Assets (Cache for 1 Year Immutably)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Product & Brand Images (Cache for 30 Days with Stale-While-Revalidate)
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
