{
  "version": 2,
  "regions": ["bom1"],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|gif|svg|webp|ico|css|js|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.js" },
    { "source": "/robots.txt", "destination": "/api/index.js" },
    { "source": "/google-merchant-feed.xml", "destination": "/api/index.js" },
    { "source": "/merchant-feed.xml", "destination": "/api/index.js" },
    { "source": "/indexnow-key.txt", "destination": "/api/index.js" },
    { "source": "/65afe1e2dec4bf210d1a3ce75cb3c7a0.txt", "destination": "/api/indexnow-key.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
