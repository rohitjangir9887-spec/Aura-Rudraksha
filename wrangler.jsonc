{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-rudraksha",
  "main": "server/cloudflare-worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // ==========================================================================
  // CLOUDFLARE WORKERS & PAGES ASSETS DEPLOYMENT
  // ==========================================================================
  // The Vite-built SPA in dist/ is served globally on Cloudflare edge.
  // - Automatic SPA fallback to /index.html for client-side routing
  // - Edge caching and HTTP/3 support
  // - server/cloudflare-worker.js automatically proxies /api/* requests
  //   to your backend when BACKEND_URL or API_BASE_URL is configured.
  // ==========================================================================
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },

  // Environment variables configured for Cloudflare Worker:
  // For production backend proxying, set BACKEND_URL in Cloudflare dashboard
  // (e.g. BACKEND_URL = "https://api.aurarudraksha.bond")
  "vars": {
    "NODE_ENV": "production"
  }
}
